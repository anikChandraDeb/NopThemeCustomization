@model AddProductToPurchaseOrderSearchModel

@{
	Layout = "_AdminPopupLayout";
	ViewBag.PageTitle = "Add Products";
}

@if (ViewBag.RefreshPage == true)
{
	<script>
		try {
			window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();
		} catch (e) { }
		window.close();
	</script>
}
else
{
	<form asp-controller="PurchaseOrder" asp-action="ProductPopup"
		  asp-route-supplierId="@Context.Request.Query["supplierId"]">
		<section class="content">
			<div class="container-fluid">
				<div class="form-horizontal">
					<div class="cards-group">
						<div class="card card-default card-popup">
							<div class="card-body">

								@await Html.PartialAsync("Table", new DataTablesModel
  {
	  Name = "products-grid",
	  UrlRead = new DataUrl("GetProductsBySupplier", "PurchaseOrder", new RouteValueDictionary { ["supplierId"] = Context.Request.Query["supplierId"] }),
	  SearchButtonId = "search-products",
	  Length = 10,
	  ColumnCollection = new List<ColumnProperty>
							{
							new ColumnProperty(nameof(ProductModel.Id))
							{
							IsMasterCheckBox = true,
							Render = new RenderCheckBox(nameof(AddProductToPurchaseOrderModel.SelectedProductIds)),
							ClassName = NopColumnClassDefaults.CenterAll,
							Width = "50"
							},
							new ColumnProperty(nameof(ProductModel.Name))
							{
							Title = "Product Name"
							},
							new ColumnProperty(nameof(ProductModel.Price))
							{
							Title = "Price",
							Width = "100",
							ClassName = NopColumnClassDefaults.CenterAll
							}
							}
  })
							</div>
							<div class="card-footer">
								<button type="submit" name="save" class="btn btn-primary">
									<i class="far fa-floppy-disk"></i> Save Selected
								</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</form>
}
