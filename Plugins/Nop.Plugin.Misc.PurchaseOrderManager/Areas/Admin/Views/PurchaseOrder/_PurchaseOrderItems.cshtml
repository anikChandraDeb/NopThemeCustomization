@using Nop.Plugin.Misc.PurchaseOrderManager.Areas.Admin.Models
@model PurchaseOrderModel

<form asp-controller="PurchaseOrder" asp-action="UpdateItems" method="post">
	@if (Model.Items.Count > 0)
	{
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<div class="card card-default">
						<div class="card-heading">
							<h3 class="card-title">@T("Admin.PurchaseOrders.PurchaseOrderItems")</h3>
						</div>
						<div class="card-body table-responsive">
							<table class="table table-bordered table-striped">
								<thead>
									<tr>
										<th>@T("Admin.PurchaseOrders.Fields.Product")</th>
										<th>@T("Admin.PurchaseOrders.Fields.Sku")</th>
										<th class="text-center">@T("Admin.PurchaseOrders.Fields.Quantity")</th>
										<th class="text-center">@T("Admin.PurchaseOrders.Fields.UnitCost")</th>
										<th class="text-center">@T("Admin.PurchaseOrders.Fields.LineTotal")</th>
										<th class="text-center">@T("Admin.Common.Delete")</th>
									</tr>
								</thead>
								<tbody>
									@for (int i = 0; i < Model.Items.Count; i++)
									{
										<tr>
											<td>
												@Model.Items[i].ProductName
												<input type="hidden" name="Items[@i].Id" value="@Model.Items[i].Id" />
												<input type="hidden" name="Items[@i].ProductName" value="@Model.Items[i].ProductName" />
												<input type="hidden" name="Items[@i].ProductId" value="@Model.Items[i].ProductId" />
											</td>
											<td>
												@Model.Items[i].Sku
												<input type="hidden" name="Items[@i].Sku" value="@Model.Items[i].Sku" />
											</td>
											<td class="text-center">
												<input type="number" name="Items[@i].Quantity" value="@Model.Items[i].Quantity" class="form-control quantity" data-index="@i" />
											</td>
											<td class="text-center">
												<input type="number" name="Items[@i].UnitCost" value="@Model.Items[i].UnitCost" class="form-control unit-cost" data-index="@i" />
											</td>
											<td class="text-center">
												<span class="line-total" id="LineTotal_@i">@Model.Items[i].LineTotal.ToString("F2")</span>
											</td>
											<td class="text-center">
												<button type="button" class="btn btn-danger btn-sm delete-item" data-id="@Model.Items[i].ProductId">
													@T("Admin.Common.Delete")
												</button>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
						<div class="card-footer">
							<div class="row">
								<div class="col-md-12">
									<div class="form-group row">
										<div class="col-md-6">
											<label>@T("Admin.PurchaseOrders.Fields.TotalAmount")</label>
										</div>
										<div class="col-md-6">
											<div class="form-text-row">
												<span id="TotalAmountDisplay">@Model.TotalAmount.ToString("F2")</span>
												<input type="hidden" asp-for="TotalAmount" />
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="container-fluid">
			<div class="row">
				<div class="col-md-12">
					<h4>No Products Selected..</h4>
				</div>
			</div>
		</div>
	}
</form>
