@model PurchaseOrderModel

<div class="card-body">
	<div class="card card-default">
		<div class="card-body">
			@await Html.PartialAsync("Table", new DataTablesModel
{
	Name = "purchaseorderitems-grid",
	UrlRead = new DataUrl("GetOrderItems", "PurchaseOrder", new RouteValueDictionary
	{
		["Keyword"] = Model.PurchaseOrderItemSearchModel.Keyword
	}),
	UrlDelete = new DataUrl("PurchaseOrderItemDelete", "PurchaseOrder", null),
	UrlUpdate = new DataUrl("PurchaseOrderItemUpdate", "PurchaseOrder", null),
	Length = 100,
	ColumnCollection = new List<ColumnProperty>
			{
			new ColumnProperty(nameof(PurchaseOrderItemModel.ProductName))
			{
			Title = T("Admin.PurchaseOrders.Fields.Product").Text
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.Sku))
			{
			Title = T("Admin.PurchaseOrders.Fields.Sku").Text
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.Quantity))
			{
			Title = T("Admin.PurchaseOrders.Fields.Quantity").Text,
			Editable = true,
			EditType = EditType.Number,
			ClassName = NopColumnClassDefaults.CenterAll
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.UnitCost))
			{
			Title = T("Admin.PurchaseOrders.Fields.UnitCost").Text,
			Editable = true,
			EditType = EditType.Number,
			ClassName = NopColumnClassDefaults.CenterAll
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.LineTotal))
			{
			Title = T("Admin.PurchaseOrders.Fields.LineTotal").Text,
			ClassName = NopColumnClassDefaults.CenterAll
			}
			,
			new ColumnProperty(nameof(PurchaseOrderItemModel.Id))
			{
			Title = T("Admin.Common.Edit").Text,
			Width = "150",
			ClassName = NopColumnClassDefaults.Button,
			Render = new RenderButtonsInlineEdit()
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.ProductId))
			{
			Title = T("Admin.Common.Delete").Text,
			Width = "100",
			Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
			ClassName = NopColumnClassDefaults.Button
			},
			new ColumnProperty(nameof(PurchaseOrderItemModel.ProductId))
			{
			Title = T("Admin.PurchaseOrders.Fields.ProductId").Text,
			Editable = true,
			EditType = EditType.Number,
			ClassName = "d-none"
			}
			}
})
		</div>
	</div>
</div>
<tfoot>
	<tr>
		<th colspan="4" style="text-align:right">@T("Admin.PurchaseOrders.Fields.TotalAmount"):</th>
		<th id="total-amount-footer" style="text-align:center"></th>
		<th colspan="2">
			<input type="hidden" asp-for="TotalAmount" id="TotalAmount" />
			<span id="total-amount-span" style="font-weight:bold;"></span>
		</th>
	</tr>
</tfoot>

<script>
	$(document).ready(function () {
		const table = $('#purchaseorderitems-grid').DataTable();

		table.on('draw', function () {
			let total = 0;
			table.column(4, { page: 'current' }).nodes().each(function (cell) {
				let value = parseFloat($(cell).text()) || 0;
				total += value;
			});

			const formattedTotal = total.toFixed(2);
			$('#total-amount-footer').text(formattedTotal);
			$('#TotalAmount').val(formattedTotal);
			$('#total-amount-span').text(formattedTotal);
		});
	});
</script>
