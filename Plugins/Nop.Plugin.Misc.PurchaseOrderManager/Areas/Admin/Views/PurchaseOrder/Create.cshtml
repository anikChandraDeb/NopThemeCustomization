@using Nop.Plugin.Misc.PurchaseOrderManager.Areas.Admin.Models
@model PurchaseOrderModel

@{
	Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
	ViewBag.PageTitle = T("Admin.PurchaseOrders.AddNew").Text;
	NopHtml.SetActiveMenuItemSystemName("PurchaseOrders");
}

<form asp-controller="PurchaseOrder" asp-action="Create" method="post" id="purchaseorder-form">
	<div class="content-header clearfix">
		<h1 class="float-left">
			@T("Admin.PurchaseOrders.AddNew")
			<small>
				<i class="fas fa-arrow-circle-left"></i>
				<a asp-action="Index">@T("Admin.Common.BackToList")</a>
			</small>
		</h1>
		<div class="float-right">
			<button type="submit" name="save" class="btn btn-primary">
				<i class="far fa-floppy-disk"></i>
				@T("Admin.Common.Save")
			</button>
			<button type="submit" name="save-continue" class="btn btn-primary">
				<i class="far fa-floppy-disk"></i>
				@T("Admin.Common.SaveContinue")
			</button>
		</div>
	</div>

	<div class="content">
		<div class="container-fluid">
			<div class="form-horizontal">

				<!-- Include Select2 CSS -->
				<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
				<style>
					/* Set the height of the Select2 container */
					.select2-container .select2-selection--single {
						height: 35px; /* Change to desired height */
					}

					/* Center the text vertically */
					.select2-container--default .select2-selection--single .select2-selection__rendered {
						line-height: 35px; /* Match this to the height above */
					}

					/* Adjust the arrow */
					.select2-container--default .select2-selection--single .select2-selection__arrow {
						height: 45px;
					}
				</style>
				<!-- Your Supplier Card -->
				<div class="mb-4">
					<div class="card card-default">
						<div class="card-body">
							<div class="form-group row">
								<div class="col-md-3">
									<nop-label asp-for="SupplierId" />
								</div>
								<div class="col-md-9">
									<nop-select asp-for="SupplierId" asp-items="Model.AvailableSuppliers" />
									<input type="hidden" id="HiddenSupplierId" name="SupplierId" value="@Model.SupplierId" />
									<span asp-validation-for="SupplierId"></span>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Second Card -->
				<div>
					<div class="card card-default">
						<div class="card-heading" style="padding: 10px;">
							@T("Admin.PurchaseOrders.Items")
						</div>
						<div class="card-body" id="purchaseorderitems-container">
							@await Html.PartialAsync("~/Plugins/Nop.Plugin.Misc.PurchaseOrderManager/Areas/Admin/Views/PurchaseOrder/_PurchaseOrderItems.cshtml", Model)
						</div>
						<div class="card-footer">
							<button type="button" id="btnAddNewProduct" class="btn btn-primary">
								@T("Admin.PurchaseOrders.AddProduct")
							</button>
							<button type="submit" id="btnRefreshProducts" style="display: none"></button>
							<script>
								$(function () {
									$('#btnRefreshProducts').click(function () {
										updateTable('#purchaseorderitems-grid');
										return false;
									});
								});
							</script>
							<script>
								$('#btnAddNewProduct').click(function () {
									var supplierId = $('#SupplierId').val();
									var url = '@Url.Action("AddProductPopup", "PurchaseOrder")' +
										'?supplierId=' + supplierId +
										'&btnId=btnRefreshProducts&formId=purchaseorder-form';

									OpenWindow(url, 900, 800, true);
									return false;
								});
							</script>
							<script>
								$(refreshPurchaseOrderItems = function () {
								  console.log('parent window..')
								  $.ajax({
									url: '@Url.Action("GetPurchaseOrderItems", "PurchaseOrder")',
									type: 'GET',
									success: function (html) {
										$('#purchaseorderitems-container').html(html);

											const itemCount = parseInt($('#purchase-order-item-count').val() || "0");
											const supplierId = $('#SupplierId').val();

											if (itemCount > 0) {
												// Disable dropdown and set hidden input value
												$('#SupplierId').attr('disabled', 'disabled');

												// Set or update hidden input with the selected value
												if ($('#HiddenSupplierId').length === 0) {
													$('<input>').attr({
														type: 'hidden',
														id: 'HiddenSupplierId',
														name: 'SupplierId',
														value: supplierId
													}).appendTo('#purchaseorder-form');
												} else {
													$('#HiddenSupplierId').val(supplierId);
												}
											} else {
												// Enable dropdown and remove hidden input
												$('#SupplierId').removeAttr('disabled');
												$('#HiddenSupplierId').remove();
											}
									},
									error: function (xhr) {
									  alert('Error refreshing purchase order items: ' + xhr.responseText);
									}
								  });
								});

								// Handle delete button click
								$(document).on('click', '.delete-item', function () {
									var productId = $(this).data('id');

									if (!confirm("Are you sure you want to delete this product?")) return;

									$.ajax({
										url: '@Url.Action("DeletePurchaseOrderItem", "PurchaseOrder")',
										type: 'POST',
										data: { productId: productId },
										success: function (response) {
											if (response.success) {
												refreshPurchaseOrderItems();
											} else {
												alert("Failed to delete item.");
											}
										},
										error: function () {
											alert("An error occurred while deleting the item.");
										}
									});
								});
							</script>

							<script>
								let isRefresh = performance.navigation.type === performance.navigation.TYPE_RELOAD;

								if (!isRefresh) {
									// Send a beacon to notify it's a fresh navigation (not refresh)
									navigator.sendBeacon("/Admin/PurchaseOrder/ClearSession");
								} else {
									console.log("Page refreshed, not clearing session.");
								}
							</script>

							<script>
								$('#purchaseorder-form').on('submit', function (e) {
									// Clear previous hidden inputs
									$('input[name^="Items["]').remove();

									let table = $('#purchaseorderitems-grid').DataTable();
									let data = table.rows().data().toArray();

									for (let i = 0; i < data.length; i++) {
										let item = data[i];

										console.log(`Item ${i}:`, item); // Log entire item object

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].ProductId`,
											value: item.ProductId
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].ProductName`,
											value: item.ProductName
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].Sku`,
											value: item.Sku
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].Quantity`,
											value: item.Quantity
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].UnitCost`,
											value: item.UnitCost
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].LineTotal`,
											value: item.LineTotal
										}).appendTo('#purchaseorder-form');

										$('<input>').attr({
											type: 'hidden',
											name: `Items[${i}].Id`,
											value: item.Id
										}).appendTo('#purchaseorder-form');
									}
								});
							</script>


							<script>
								function updateSupplierDropdownState() {
									const table = $('#purchaseorderitems-grid').DataTable();
									const itemCount = table.rows().count();
									const supplierId = $('#SupplierId').val();

									if (itemCount > 0) {
										$('#SupplierId').attr('disabled', 'disabled');
										if ($('#HiddenSupplierId').length === 0) {
											$('<input>').attr({
												type: 'hidden',
												id: 'HiddenSupplierId',
												name: 'SupplierId',
												value: supplierId
											}).appendTo('#purchaseorder-form');
										}
									} else {
										$('#SupplierId').removeAttr('disabled');
										$('#HiddenSupplierId').remove();
									}
								}

								$(document).on('draw.dt', '#purchaseorderitems-grid', function () {
									updateSupplierDropdownState();
								});
							</script>



						</div>
					</div>
				</div>

			</div>
		</div>
	</div>
</form>
<!-- Include Select2 JS -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script>
	$(document).ready(function () {
		$('#SupplierId').select2({
			width: '100%',
			placeholder: 'Select a supplier',
			allowClear: true
		});
	});
</script>